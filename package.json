{
  "name": "office-of-equity-open-notebook",
  "productName": "Office of Equity Open Notebook",
  "version": "1.14.0",
  "description": "Office of Equity Open Notebook — a job-specific Windows desktop app for the Office of Equity, built on Open Notebook (a private, multi-model, 100% local Notebook LM alternative).",
  "main": "main.js",
  "author": {
    "name": "Office of Equity"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.js",
    "start": "cargo run --manifest-path src-tauri/Cargo.toml",
    "package:app": "node scripts/package-native.js",
    "installer": "node scripts/build-installer-native.js",
    "typecheck": "tsc --noEmit",
    "build:types": "node scripts/build-types.js",
    "start:electron": "electron .",
    "package:electron": "node scripts/package.js",
    "installer:electron": "node scripts/build-installer.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "electron": "^33.2.0",
    "typescript": "^5.7.3"
  }
}