{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://127.0.0.1:8502",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Office of Equity Open Notebook",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "message": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.officeequity.opennotebook",
      "icon": ["../open-notebook/frontend/src/app/favicon.ico"],
      "targets": ["msi", "appimage", "dmg"]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Office of Equity Open Notebook",
        "width": 1440,
        "minWidth": 1024,
        "minHeight": 700
      }
    ]
  }
}
